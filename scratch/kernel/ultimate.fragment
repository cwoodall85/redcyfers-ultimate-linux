# Ultimate Linux kernel options, merged over x86_64_defconfig.
# Grouped by why they are here. Built-in (=y) for anything needed to reach
# the root filesystem; modules (=m) for hardware a given machine may lack.

# --- what systemd requires (LFS 13.1 "Configuring the Linux kernel") ---
CONFIG_PSI=y
CONFIG_MEMCG=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_BPF_SYSCALL=y
CONFIG_DMIID=y
CONFIG_IPV6=y
CONFIG_NET_SCHED=y
CONFIG_RTC_CLASS=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_PARTITION=y
CONFIG_DM_CRYPT=m
CONFIG_ZRAM=m

# --- filesystems ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=m
CONFIG_XFS_FS=m
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_FUSE_FS=m
CONFIG_OVERLAY_FS=m
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_BLK_DEV_LOOP=y
CONFIG_NFS_FS=m
CONFIG_CIFS=m

# --- the libvirt test VM (and any KVM/QEMU guest) ---
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_INPUT=m
CONFIG_HW_RANDOM_VIRTIO=m
CONFIG_SCSI_VIRTIO=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_SR=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_QXL=m
CONFIG_DRM_BOCHS=m

# --- desktop graphics, input, sound ---
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# flicker-free boot: the console leaves the firmware's picture alone until
# it has something to print, so the boot screen follows it without a black gap
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_NOUVEAU=m
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=m
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=m
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
# Codecs: without one, snd_hda_intel finds the controller but no card (no
# sound at all, in VMs too). tools/make-kernel-config.sh also turns on every
# per-chip codec option under these (Realtek, HDMI, Cirrus... are split per
# chip in 7.x).
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_SEQUENCER=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_USB_XHCI_HCD=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K10TEMP=m

# --- networking: NetworkManager, wireless, VPNs, firewall ---
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_TUN=m
CONFIG_WIREGUARD=m
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m
CONFIG_VETH=m
CONFIG_MACVLAN=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_ATH11K=m
CONFIG_MT7921E=m
CONFIG_RTW89=m
CONFIG_E1000E=m
CONFIG_IGC=m
CONFIG_R8169=m
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_CT_NETLINK=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m

# --- containers and namespaces for sandboxes (WebKit's bubblewrap) ---
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# --- misc ---
CONFIG_KERNEL_ZSTD=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOCALVERSION="-ultimate"

# --- booting real machines without an initramfs --------------------------
# The root filesystem's driver has to be built in. USB sticks (the image is
# also the installer) and SD cards, not only NVMe/SATA/virtio:
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
# UEFI's framebuffer as a simple-framebuffer, so simpledrm shows a console
# before the GPU driver loads.
CONFIG_SYSFB_SIMPLEFB=y

# --- Real hardware (2026-09-29) -----------------------------------------
# Firmware for GPUs, Wi-Fi, Bluetooth and laptop audio comes from
# linux-firmware and sof-firmware, installed zstd-compressed.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
# Wi-Fi: the common laptop and desktop chips. tools/make-kernel-config.sh
# also turns on every per-chip option under these families (kernel/all-of.list).
CONFIG_IWLMLD=m
CONFIG_ATH9K=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_RTW88=m
CONFIG_MT7925E=m
CONFIG_MT7921U=m
CONFIG_BRCMFMAC=m
CONFIG_RTL8XXXU=m
# Wired: Intel 1G/10G/40G, Aquantia, and the usual USB adapters
CONFIG_IGB=m
CONFIG_IXGBE=m
CONFIG_I40E=m
CONFIG_AQTION=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDC_NCM=m
# Laptop audio on Intel (Sound Open Firmware, AVS) and AMD (ACP) DSPs,
# which sit on ALSA's SoC layer and, on recent Intel, SoundWire
CONFIG_SND_SOC=m
CONFIG_SOUNDWIRE=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_AMD_TOPLEVEL=m
CONFIG_SND_SOC_AMD_ACP=m
CONFIG_SND_SOC_INTEL_MACH=y
# Laptop plumbing: Intel LPSS and DesignWare I2C/SPI carry touchpads (I2C
# HID), audio amplifiers and codecs; pin controllers route their interrupts.
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_I2C_DESIGNWARE_PCI=m
CONFIG_I2C_HID=m
CONFIG_I2C_HID_ACPI=m
CONFIG_GPIOLIB=y
CONFIG_PINCTRL=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_PINCTRL_AMD=y
CONFIG_SPI=y
CONFIG_SPI_PXA2XX=m
# Thunderbolt / USB4 docks, and Intel VMD (NVMe drives behind it are
# invisible without the driver on many recent Intel laptops)
CONFIG_USB4=m
CONFIG_VMD=y
# --- Chris's desktop (Ryzen 9 9950X, AMD 800-series board), from lsmod on
# Fedora 2026-09-29: everything it loads must exist here -----------------
# Virtualisation: libvirt/KVM guests with vhost networking
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_KVM_AMD=m
CONFIG_KVM_INTEL=m
CONFIG_VHOST_NET=m
CONFIG_VSOCKETS=m
CONFIG_VHOST_VSOCK=m
CONFIG_TUN=m
CONFIG_MACVTAP=m
CONFIG_BRIDGE=m
CONFIG_VETH=m
# Input: the Aula F108 Pro presents as an Apple keyboard over Bluetooth
# (hid_apple, fnmode=2); Logitech receivers; headsets; BLE HID via uhid
CONFIG_HID_APPLE=m
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_HID_PLANTRONICS=m
CONFIG_UHID=m
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_PCSPKR=m
CONFIG_APPLE_MFI_FASTCHARGE=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
# Webcams: UVC and the gspca family (an SN9C2028 camera is attached)
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_VIDEO_DEV=m
CONFIG_USB_VIDEO_CLASS=m
CONFIG_USB_GSPCA=m
CONFIG_USB_GSPCA_SN9C2028=m
# Sensors and platform: SMBus, DDR5 SPD temperatures, memory-error decoding,
# the chipset watchdog, power reporting, i2c-dev for RGB/monitor tools
CONFIG_I2C_PIIX4=m
CONFIG_I2C_CHARDEV=m
CONFIG_SENSORS_SPD5118=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_RAS=y
CONFIG_EDAC=y
CONFIG_EDAC_AMD64=m
CONFIG_SP5100_TCO=m
CONFIG_WATCHDOG=y
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=m
CONFIG_GPIO_AMDPT=m
CONFIG_X86_AMD_PSTATE=y
CONFIG_AMD_PMC=m
# USB serial (microcontrollers, modems), USB MIDI 2.0
CONFIG_USB_ACM=m
CONFIG_SND_USB_AUDIO_MIDI_V2=y
# Firewall (firewalld's nftables) and libvirt's traffic shaping
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK_TFTP=m
CONFIG_NF_NAT_TFTP=m
CONFIG_NF_CONNTRACK_NETBIOS_NS=m
CONFIG_NET_SCH_HTB=m
CONFIG_NET_CLS_U32=m
CONFIG_NET_ACT_CSUM=m
# The whole netfilter stack, as Arch and Fedora ship it: Podman's netavark
# failed on a minimal nftables ("Operation not supported"), and iptables-nft,
# firewalld, Docker-style bridges and ipset need the rest. These are the
# parents; kernel/all-of.list turns on every option under them.
CONFIG_NETFILTER_XTABLES=m
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_BRIDGE=m
CONFIG_NF_TABLES_ARP=y
CONFIG_NFT_COMPAT=m
CONFIG_NF_FLOW_TABLE=m
CONFIG_NF_FLOW_TABLE_INET=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP_NF_NAT=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_RAW=m
CONFIG_BRIDGE_NF_EBTABLES=m
CONFIG_IP_SET=m
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_NETLINK_LOG=m
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CONNTRACK_TIMESTAMP=y
CONFIG_NF_CONNTRACK_LABELS=y
# zram swap (what Fedora uses; LZ4 as on this machine)
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4HC=y
CONFIG_HID_BATTERY_STRENGTH=y
# Encrypted disks (cryptsetup/LUKS2): AES-XTS, and the user-space crypto API
# cryptsetup uses
CONFIG_CRYPTO_XTS=m
CONFIG_CRYPTO_AES_NI_INTEL=m
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
