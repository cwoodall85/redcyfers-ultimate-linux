#!/bin/bash
# iperf3 -- not in BLFS; built by hand for the Ultimate layer's network tools.
# Source: https://github.com/esnet/iperf/archive/refs/tags/3.21/iperf3-3.21.tar.gz
# Checksum (b2) from Arch's package recipe; verified on download.
set -e
# fetched by fetch.py: wget -T 30 -t 5 "https://github.com/esnet/iperf/archive/refs/tags/3.21/iperf3-3.21.tar.gz"
FILE=iperf3-3.21.tar.gz
cd /sources
echo "7ac39edca583485ef4943850df79ccfd834439a042caa4cc4c2c8a436a4057f8846738c43dcdc92e32a318a4d0f354cc2449677b2cf94286b05556762a118081  $FILE" | b2sum -c -
W=/sources/blfs/extra-iperf3
rm -rf $W && mkdir -p $W && cd $W
tar --no-same-owner -xf /sources/$FILE
cd "$(ls -d */ | head -1)"
export MAKEFLAGS="-j$(nproc)"

./configure --prefix=/usr --disable-static
make
make install

cd / && rm -rf $W
ldconfig
