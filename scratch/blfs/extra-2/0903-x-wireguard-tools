#!/bin/bash
# wireguard-tools -- not in BLFS; built by hand for the Ultimate layer's network tools.
# Source: https://git.zx2c4.com/wireguard-tools/snapshot/wireguard-tools-1.0.20260223.tar.xz
# Checksum: sha256 of the release as first downloaded over HTTPS (trust on first use).
set -e
# fetched by fetch.py: wget -T 30 -t 5 "https://git.zx2c4.com/wireguard-tools/snapshot/wireguard-tools-1.0.20260223.tar.xz"
FILE=wireguard-tools-1.0.20260223.tar.xz
cd /sources
echo "af459827b80bfd31b83b08077f4b5843acb7d18ad9a33a2ef532d3090f291fbf  $FILE" | sha256sum -c -
W=/sources/blfs/extra-wireguard-tools
rm -rf $W && mkdir -p $W && cd $W
tar --no-same-owner -xf /sources/$FILE
cd "$(ls -d */ | head -1)"
export MAKEFLAGS="-j$(nproc)"

make -C src
make -C src PREFIX=/usr WITH_BASHCOMPLETION=yes WITH_WGQUICK=yes \
     WITH_SYSTEMDUNITS=yes install

cd / && rm -rf $W
ldconfig
