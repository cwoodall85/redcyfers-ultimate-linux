#!/bin/bash
# mtr -- not in BLFS; built by hand for the Ultimate layer's network tools.
# Source: https://github.com/traviscross/mtr/archive/v0.96/mtr-0.96.tar.gz
# Checksum (b2) from Arch's package recipe; verified on download.
set -e
# fetched by fetch.py: wget -T 30 -t 5 "https://github.com/traviscross/mtr/archive/v0.96/mtr-0.96.tar.gz"
FILE=mtr-0.96.tar.gz
cd /sources
echo "c7dff18b6f6e48a648783d719a6cedd14b141fe2013b75031f3ee830e8c4fb9c93639259c860047c8108c21519df30740f7515256ed08552f7697a42e938257b  $FILE" | b2sum -c -
W=/sources/blfs/extra-mtr
rm -rf $W && mkdir -p $W && cd $W
tar --no-same-owner -xf /sources/$FILE
cd "$(ls -d */ | head -1)"
export MAKEFLAGS="-j$(nproc)"

./bootstrap.sh
./configure --prefix=/usr --sbindir=/usr/bin --without-gtk
make
make install

cd / && rm -rf $W
ldconfig
