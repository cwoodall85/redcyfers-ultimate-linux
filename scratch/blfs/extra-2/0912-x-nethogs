#!/bin/bash
# nethogs -- not in BLFS; built by hand for the Ultimate layer's network tools.
# Source: https://github.com/raboof/nethogs/archive/v0.8.8/nethogs-0.8.8.tar.gz
# Checksum (sha256) from Arch's package recipe; verified on download.
set -e
# fetched by fetch.py: wget -T 30 -t 5 "https://github.com/raboof/nethogs/archive/v0.8.8/nethogs-0.8.8.tar.gz"
FILE=nethogs-0.8.8.tar.gz
cd /sources
echo "111ade20cc545e8dfd7ce4e293bd6b31cd1678a989b6a730bd2fa2acc6254818  $FILE" | sha256sum -c -
W=/sources/blfs/extra-nethogs
rm -rf $W && mkdir -p $W && cd $W
tar --no-same-owner -xf /sources/$FILE
cd "$(ls -d */ | head -1)"
export MAKEFLAGS="-j$(nproc)"

make nethogs
make PREFIX=/usr sbin=/usr/bin install

cd / && rm -rf $W
ldconfig
