#!/bin/bash
# CPU microcode, loaded before the kernel starts anything else. There is no
# initramfs, so each vendor's microcode goes in a tiny cpio archive of its
# own (/boot/amd-ucode.img, /boot/intel-ucode.img) that GRUB passes as the
# initrd: the kernel's early loader takes kernel/x86/microcode/*.bin from it,
# finds no /init, and mounts the real root as usual.
# AMD: from linux-firmware (amd-ucode/, installed by an earlier step, zstd-
# compressed there). Intel: Intel's release tarball; sha256 recorded on first
# download here (TOFU).
set -e
# fetched by fetch.py: wget -T 30 -t 5 "https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files/archive/refs/tags/microcode-20260925.tar.gz"
FILE=microcode-20260925.tar.gz
cd /sources
echo "0ec19023dad1e6dd0c5909174b8dff2555b91cf01671e36271a1ef36655c0cfc  $FILE" | sha256sum -c -
W=/sources/blfs/extra-ucode
rm -rf $W && mkdir -p $W && cd $W
tar --no-same-owner -xf /sources/$FILE

mk() {  # image vendor-file sources...
  local img=$1 name=$2; shift 2
  rm -rf root && mkdir -p root/kernel/x86/microcode
  cat "$@" > root/kernel/x86/microcode/$name
  (cd root && find . | sort | cpio -o -H newc -R 0:0 --quiet) > /boot/$img
  echo "$img: $(stat -c%s /boot/$img) bytes"
}
# AMD: linux-firmware ships amd-ucode/*.bin(.zst)
mkdir -p amd
for f in /usr/lib/firmware/amd-ucode/microcode_amd*.bin*; do
  case $f in *.zst) zstd -qdc "$f" > amd/$(basename "$f" .zst) ;; *) cp "$f" amd/ ;; esac
done
mk amd-ucode.img AuthenticAMD.bin amd/*.bin
mk intel-ucode.img GenuineIntel.bin Intel-Linux-Processor-Microcode-Data-Files-microcode-20260925/intel-ucode/*
cd / && rm -rf $W
