# Built on Ultimate Linux itself (makepkg -d), not by build.sh.
# dmidecode: reads the firmware's hardware tables; libvirt uses it for
# host capabilities. Signed by Jean Delvare (7CA69F4460F1BDC41FD2C858A5526B9BB3CD4E6A).
pkgname=dmidecode
pkgver=3.7
pkgrel=1
pkgdesc="Desktop Management Interface table related utilities"
arch=('x86_64')
url="https://www.nongnu.org/dmidecode/"
license=('GPL-2.0-or-later')
depends=('glibc')
source=("https://download.savannah.gnu.org/releases/dmidecode/dmidecode-${pkgver}.tar.xz")
sha256sums=('2c3aed12c85a1e6a9410d406d5e417c455466dc1bc7c89278bb32cf7cad91e8a')

build() {
  cd "dmidecode-$pkgver"
  make prefix=/usr CFLAGS="$CFLAGS"
}

package() {
  cd "dmidecode-$pkgver"
  make prefix=/usr sbindir=/usr/bin DESTDIR="$pkgdir" install
}
