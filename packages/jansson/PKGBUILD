# Built on Ultimate Linux itself (makepkg -d), not by build.sh.
# jansson: C library for JSON; nftables' JSON interface (nft -j) needs it.
pkgname=jansson
pkgver=2.15.1
pkgrel=1
pkgdesc="C library for encoding, decoding and manipulating JSON data"
arch=('x86_64')
url="https://github.com/akheron/jansson"
license=('MIT')
depends=('glibc')
source=("https://github.com/akheron/jansson/releases/download/v${pkgver}/jansson-${pkgver}.tar.gz")
sha256sums=('0c7114dc0b2d22a670724a1f95922029d7077c19dbf79a584cb8084d2f267f2f')

build() {
  cd "jansson-$pkgver"
  ./configure --prefix=/usr --disable-static
  make
}

package() {
  cd "jansson-$pkgver"
  make DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
