# Built on Ultimate Linux itself (makepkg -d), not by build.sh.
# osinfo-db-tools: install/validate the OS database libosinfo reads.
# Signed by Victor Toso (97D9123DE37A484F); checksum pinned after gpg --verify.
pkgname=osinfo-db-tools
pkgver=1.12.0
pkgrel=1
pkgdesc="Tools for managing the osinfo database"
arch=('x86_64')
url="https://libosinfo.org/"
license=('GPL-2.0-or-later')
depends=('glib2' 'libxml2' 'libxslt' 'libarchive' 'json-glib' 'libsoup3')
source=("https://releases.pagure.org/libosinfo/osinfo-db-tools-${pkgver}.tar.xz")
sha256sums=('f3315f675d18770f25dea8ed04b20b8fc80efb00f60c37ee5e815f9c3776e7f3')

build() {
  meson setup build "osinfo-db-tools-$pkgver" --prefix=/usr --buildtype=release
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
