# Built on Ultimate Linux itself (makepkg -d), not by build.sh.
# QEMU: the x86_64 system emulator with KVM, and qemu-img -- what the
# distro's test VMs (libvirt) run on. One target only; SPICE console,
# user-mode networking (libslirp), vhost, virtio-fs support in the guest
# side. Release signed by Michael Roth (CEACC9E15534EBABB82D3FA03353C9CEF108B584);
# checksum pinned after gpg --verify passed.
pkgname=qemu
pkgver=11.1.1
pkgrel=2
pkgdesc="Machine emulator and virtualizer (x86_64 system target + tools)"
arch=('x86_64')
url="https://www.qemu.org/"
license=('GPL-2.0-only' 'LGPL-2.1-or-later')
depends=('glib2' 'pixman' 'libslirp' 'spice-server' 'zlib' 'zstd' 'libcap-ng'
         'libseccomp' 'gnutls' 'libusb' 'fuse3' 'edk2-ovmf' 'systemd')
makedepends=('spice-protocol' 'meson' 'ninja' 'Python')
options=('!lto')
source=("https://download.qemu.org/qemu-${pkgver}.tar.xz")
sha256sums=('079ffbff8a7111bbc89022107cbabf3bbfd614d5fc9d7cc675991196aca12482')

build() {
  mkdir -p build && cd build
  "../qemu-$pkgver/configure" --prefix=/usr --sysconfdir=/etc --localstatedir=/var \
    --libexecdir=/usr/lib/qemu --target-list=x86_64-softmmu \
    --enable-kvm --enable-spice --enable-slirp --enable-vhost-net --enable-vhost-user \
    --enable-seccomp --enable-cap-ng --enable-gnutls --enable-libusb --enable-tools \
    --enable-fuse --enable-zstd \
    --disable-docs --disable-werror --disable-download --disable-sdl --disable-gtk \
    --disable-xen --disable-debug-info
  ninja
}

package() {
  cd build
  DESTDIR="$pkgdir" ninja install
  # /var/run is a link to /run here; an empty var/run/ directory in the
  # package makes pacman refuse the whole transaction.
  rm -rf "$pkgdir/var/run"; rmdir "$pkgdir/var" 2>/dev/null || true
  # libvirt expects the emulator at its usual name; the bridge helper
  # (qemu-bridge-helper) must be setuid for unprivileged bridged guests.
  chmod u+s "$pkgdir/usr/lib/qemu/qemu-bridge-helper"
  install -Dm644 /dev/stdin "$pkgdir/etc/qemu/bridge.conf" <<'CONF'
allow virbr0
CONF
}
backup=('etc/qemu/bridge.conf')
