# Built on Ultimate Linux itself (makepkg -d), not by build.sh.
# dnsmasq: DHCP + DNS for libvirt's virtual networks (virbr0). Release
# signed by Simon Kelley (D6EACBD6EE46B834248D111215CDDA6AE19135A2);
# checksum pinned after gpg --verify passed.
pkgname=dnsmasq
pkgver=2.93
pkgrel=1
pkgdesc="Lightweight DNS forwarder and DHCP server"
arch=('x86_64')
url="https://thekelleys.org.uk/dnsmasq/doc.html"
license=('GPL-2.0-or-later')
depends=('glibc' 'dbus')
backup=('etc/dnsmasq.conf')
source=("https://thekelleys.org.uk/dnsmasq/dnsmasq-${pkgver}.tar.xz")
sha256sums=('0c00d4e5c97c8306e5fb932b348b34269c9c29a0e7df0e8e82958b407092bc19')

build() {
  cd "dnsmasq-$pkgver"
  make PREFIX=/usr BINDIR=/usr/bin CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS" COPTS="-DHAVE_DBUS"
}

package() {
  cd "dnsmasq-$pkgver"
  make PREFIX=/usr BINDIR=/usr/bin DESTDIR="$pkgdir" install
  install -Dm644 dnsmasq.conf.example "$pkgdir/etc/dnsmasq.conf"
  install -Dm644 dbus/dnsmasq.conf "$pkgdir/usr/share/dbus-1/system.d/dnsmasq.conf"
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/sysusers.d/dnsmasq.conf" <<'CONF'
u dnsmasq - "dnsmasq daemon" /
CONF
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/dnsmasq.service" <<'UNIT'
[Unit]
Description=dnsmasq - A lightweight DHCP and caching DNS server
After=network.target
Before=network-online.target nss-lookup.target
Wants=nss-lookup.target

[Service]
Type=dbus
BusName=uk.org.thekelleys.dnsmasq
ExecStartPre=/usr/bin/dnsmasq --test
ExecStart=/usr/bin/dnsmasq -k --enable-dbus --user=dnsmasq --pid-file
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
PrivateDevices=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
UNIT
}
