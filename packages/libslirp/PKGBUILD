# Built on Ultimate Linux itself (makepkg -d), not by build.sh.
# libslirp: user-mode TCP/IP for QEMU guests (-netdev user).
pkgname=libslirp
pkgver=4.9.5
pkgrel=1
pkgdesc="General purpose TCP-IP emulator"
arch=('x86_64')
url="https://gitlab.freedesktop.org/slirp/libslirp"
license=('BSD-3-Clause')
depends=('glib2')
source=("libslirp-${pkgver}.tar.gz::https://gitlab.freedesktop.org/slirp/libslirp/-/archive/v${pkgver}/libslirp-v${pkgver}.tar.gz")
sha256sums=('f43e68b60b580647574ec4a0e2b6c600a56281e6c39f79426510832dc810f483')

build() {
  meson setup build "libslirp-v$pkgver" --prefix=/usr --buildtype=release -Ddefault_library=shared
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "libslirp-v$pkgver/COPYRIGHT" "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT"
}
