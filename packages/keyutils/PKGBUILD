# Built on Ultimate Linux itself (makepkg -d), not by build.sh: it goes
# with google-chrome into the private package set, and links against
# this system's libraries (OpenSSL 4), which Arch's container lacks.
# keyutils: the kernel key-retention service's library and tools
# (mokutil needs libkeyutils).
pkgname=keyutils
pkgver=1.6.3
pkgrel=1
pkgdesc="Linux key management utilities"
arch=('x86_64')
url="https://git.kernel.org/pub/scm/linux/kernel/git/dhowells/keyutils.git"
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later')
depends=('glibc')
backup=('etc/request-key.conf')
source=("https://git.kernel.org/pub/scm/linux/kernel/git/dhowells/keyutils.git/snapshot/keyutils-${pkgver}.tar.gz")
sha256sums=('a61d5706136ae4c05bd48f86186bcfdbd88dd8bd5107e3e195c924cfc1b39bb4')

build() {
  cd "keyutils-$pkgver"
  make CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

package() {
  cd "keyutils-$pkgver"
  make DESTDIR="$pkgdir" SBINDIR=/usr/sbin BINDIR=/usr/bin LIBDIR=/usr/lib \
    USRLIBDIR=/usr/lib SHAREDIR=/usr/share/keyutils INCLUDEDIR=/usr/include install
}
