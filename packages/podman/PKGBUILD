# Built on Ultimate Linux itself (makepkg -d), not by build.sh.
# Podman: daemonless containers (rootless by default). The distro's own
# image builds run in rootless Podman.
pkgname=podman
pkgver=6.1.3
pkgrel=1
pkgdesc="Tool and library for running OCI-based containers in pods"
arch=('x86_64')
url="https://podman.io/"
license=('Apache-2.0')
depends=('conmon' 'crun' 'containers-common' 'netavark' 'aardvark-dns' 'passt'
         'gpgme' 'libseccomp' 'systemd' 'shadow' 'fuse3' 'iptables' 'nftables')
makedepends=('go')
options=('!lto' '!strip')
_tags="seccomp systemd exclude_graphdriver_btrfs exclude_graphdriver_devicemapper"
source=("podman-${pkgver}.tar.gz::https://github.com/podman-container-tools/podman/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('6253aee14e573f747ca77e5a83a0df4ef9c2f609604f56715070ed06b6f9ddd8')

build() {
  cd "podman-$pkgver"
  export GOFLAGS="-buildmode=pie -trimpath -mod=vendor -modcacherw"
  export CGO_CFLAGS="$CFLAGS" CGO_LDFLAGS="$LDFLAGS"
  make BUILDTAGS="$_tags" PREFIX=/usr EXTRA_LDFLAGS="-s -w" binaries
}

package() {
  cd "podman-$pkgver"
  # install.systemd only does anything when the build tags name systemd.
  # Podman looks for its helpers (netavark, aardvark-dns, rootlessport)
  # in /usr/lib/podman among others; install.bin uses LIBEXECDIR/podman.
  make DESTDIR="$pkgdir" PREFIX=/usr LIBEXECDIR=/usr/lib BUILDTAGS="$_tags" \
    install.bin install.systemd install.completions
}
