[Unit]
Description=Ultimate Linux assistant: answers #claude in Ultimate Chat, runs your schedules
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/ultimate-agent serve
Restart=on-failure
RestartSec=20
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
