# Built on Ultimate Linux itself (tools/native-makepkg.sh), into this
# system's Qt (/opt/qt6 -> /opt/qt-6.11.2), which BLFS built without it.
# QtWebEngine: Chromium as a Qt module. Ultimate Browser is built on it.
# Also gives QtPdf and the QML WebEngineView.
#
# Build-time only, fetched here rather than installed: Node.js (Chromium's
# build runs JS tooling) and html5lib + its two dependencies (Chromium's
# Python scripts import it).
# Long build: ~2-3 h on 32 cores; the link steps want lots of memory, so
# jobs are capped (NINJAJOBS, default 24).
pkgname=qt6-webengine
pkgver=6.11.2
pkgrel=1
_node=24.21.0
pkgdesc="Qt WebEngine: Chromium for Qt (Ultimate Browser's engine), plus QtPdf"
arch=('x86_64')
url="https://www.qt.io"
license=('LGPL-3.0-only' 'BSD-3-Clause')
makedepends=('cmake' 'ninja' 'gperf' 'bison' 'flex')
source=("https://download.qt.io/official_releases/qt/6.11/${pkgver}/submodules/qtwebengine-everywhere-src-${pkgver}.tar.xz"
        "https://nodejs.org/dist/v${_node}/node-v${_node}-linux-x64.tar.xz"
        "https://files.pythonhosted.org/packages/6c/dd/a834df6482147d48e225a49515aabc28974ad5a4ca3215c18a882565b028/html5lib-1.1-py2.py3-none-any.whl"
        "https://files.pythonhosted.org/packages/77/c6/040cbc72480d789a5f40d63fb484d3106554c4dfa2d2b70ad5022057750f/webencodings-0.6.1-py3-none-any.whl"
        "https://files.pythonhosted.org/packages/b7/ce/149a00dd41f10bc29e5921b496af8b574d8413afcd5e30dfa0ed46c2cc5e/six-1.17.0-py2.py3-none-any.whl")
noextract=("html5lib-1.1-py2.py3-none-any.whl" "webencodings-0.6.1-py3-none-any.whl" "six-1.17.0-py2.py3-none-any.whl")
sha256sums=('6101c1aa00ff933d1b65ee5d167f76e8d71b9ac5b378b0111277723ebda7c163'
            'fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6'
            '0d78f8fde1c230e99fe37986a60526d7049ed4bf8a9fadbad5f00e22e58e041d'
            '7fab6269c8bf237c657876b52058ccb182e861518d1c695c1a9aaa8c1c105d5b'
            '4721f391ed90541fddacab5acf947aa0d3dc7d27b2e1e8eda2be8970586c3274')
options=('!lto' '!debug')

_qt=/opt/qt6
_qtreal=/opt/qt-6.11.2

build() {
  rm -rf pydeps && mkdir pydeps
  local w
  for w in *.whl; do python3 -m zipfile -e "$w" pydeps; done
  export PYTHONPATH="$srcdir/pydeps${PYTHONPATH:+:$PYTHONPATH}"
  export PATH="$srcdir/node-v${_node}-linux-x64/bin:$PATH"
  export NINJAFLAGS="-j${NINJAJOBS:-24}"
  # Bundled Chromium libraries throughout (ICU, ffmpeg, libvpx, ...): the
  # system's are BLFS-current, which Chromium's pinned code often isn't.
  # Proprietary codecs on: H.264/AAC video on ordinary sites.
  $_qt/bin/qt-cmake -B build -S "qtwebengine-everywhere-src-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$_qt \
    -DQT_FEATURE_webengine_proprietary_codecs=ON \
    -DQT_FEATURE_webengine_system_icu=OFF \
    -DQT_FEATURE_webengine_system_ffmpeg=OFF \
    -DQT_FEATURE_webengine_system_libevent=OFF \
    -DQT_FEATURE_webengine_system_re2=OFF \
    -DQT_FEATURE_webengine_system_snappy=OFF \
    -DQT_FEATURE_webengine_kerberos=OFF \
    -DQT_FEATURE_webengine_webrtc_pipewire=ON \
    -DQT_BUILD_EXAMPLES=OFF -DQT_BUILD_TESTS=OFF
  cmake --build build --parallel "${NINJAJOBS:-24}"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # /opt/qt6 is a symlink to the versioned tree: files belong under the real one.
  mkdir -p "$pkgdir/opt"
  if [[ -d "$pkgdir$_qt" && ! -L "$pkgdir$_qt" ]]; then
    mv "$pkgdir$_qt" "$pkgdir$_qtreal"
  fi
  # Directories of that tree that are symlinks into /usr on this system:
  # pacman won't put a directory where a symlink is.
  local d rel target
  for d in $(find "$_qtreal" -maxdepth 4 -type l -xtype d); do
    rel=${d#/}; target=$(readlink -f "$d")
    [[ -d "$pkgdir/$rel" && ! -L "$pkgdir/$rel" ]] || continue
    mkdir -p "$pkgdir$target"
    cp -a "$pkgdir/$rel/." "$pkgdir$target/"
    rm -rf "$pkgdir/$rel"
  done
}
